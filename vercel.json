{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "apps/web/dist",
  "rewrites": [{ "source": "/api/v1/:path*", "destination": "/api" }],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  }
}
