# Server-only variables (TASKS.md §0.3). Copy to apps/api/.env (git-ignored)
# or run `vercel env pull apps/api/.env`. Never commit real values.
PORT=3001
DATABASE_URL=postgres://user:password@host/db
# Optional. Per-instance postgres.js pool size (apps/api/src/db/index.ts); defaults to 5.
DATABASE_POOL_MAX=5
SESSION_SECRET=replace_locally
APP_ORIGIN=http://localhost:5173
DEMO_MODE=true

MODEL_PROVIDER=mock
AZURE_OPENAI_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=replace_locally
AZURE_OPENAI_DEPLOYMENT=YOUR_DEPLOYMENT_NAME

TERMINAL3_MODE=mock
T3N_API_KEY=replace_locally
# Optional. When set, the enclave contract is called with the assistant's own
# Terminal 3 identity instead of the tenant's, so evidence.agent_did names an
# agent rather than the operator. Must be a SECOND key from the claim page --
# an agent DID's credits are separate and start at zero.
T3N_AGENT_KEY=
# Required only alongside T3N_AGENT_KEY: the DID that owns the contract, since
# the agent's session cannot supply it.
T3N_TENANT_DID=
